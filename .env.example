# Copy to .env and fill in. NEVER commit real secrets.

# --- Devin API (required) ---
DEVIN_API_KEY=cog_your_service_user_key
DEVIN_ORG_ID=your_org_id
DEVIN_BASE_URL=https://api.devin.ai/v3
# Optional: attribute sessions to a human user (needs ImpersonateOrgSessions perm)
CREATE_AS_USER_ID=

# --- GitHub (token required for issue comments / live runs) ---
GITHUB_TOKEN=ghp_your_pat_with_repo_and_admin_repo_hook
REPO=MattBr0wne1/superset
TRIGGER_LABEL=devin-fix
# Shared secret used to validate inbound webhook signatures (recommended)
WEBHOOK_SECRET=

# --- Trigger: periodic label scan (the local-friendly "pull" trigger) ---
# When enabled, the service polls the repo for issues carrying TRIGGER_LABEL and
# dispatches new ones — so labeling on GitHub auto-runs with no public URL.
# Requires a valid GITHUB_TOKEN. Set to false to rely solely on the webhook.
LABEL_SCAN_ENABLED=true
LABEL_SCAN_INTERVAL_SECONDS=60

# --- Storage / behaviour ---
DB_PATH=remediation.db
SUMMARY_PATH=summary.md
POLL_INTERVAL_SECONDS=20
